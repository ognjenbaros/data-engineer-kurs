-- 6. Највећа победа и најтежи пораз.

WITH        club AS (SELECT team_id FROM teams WHERE team_name = 'Queensport FC'),

        difference AS (SELECT  match_id, home_goals - away_goals AS goal_diff
                    FROM matches AS m
                    JOIN club AS c ON c.team_id = m.home_team_id AND season = '2024/25'
                    UNION
                    SELECT  match_id, away_goals - home_goals AS goal_diff
                    FROM matches AS m
                    JOIN club AS c ON c.team_id = m.away_team_id AND season = '2024/25'
                    ),
     max_min_diff AS ((SELECT match_id
                       FROM difference
                       ORDER BY goal_diff DESC
                       LIMIT 1)
                       UNION
                       (SELECT match_id
                       FROM difference
                       ORDER BY goal_diff
                       LIMIT 1)
                    )
SELECT mmd.match_id, CONCAT(ht.team_name, ' ', m.home_goals,':', m.away_goals,' ', awt.team_name) AS game
FROM max_min_diff AS mmd
JOIN matches AS m ON m.match_id = mmd.match_id
JOIN teams AS ht ON ht.team_id = m.home_team_id
JOIN teams AS awt ON awt.team_id = m.away_team_id;


