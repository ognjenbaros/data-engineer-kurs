
--Zadatak 1)

SELECT match_id, home_team, away_team, stadium_name,
    (stadium_capacity - attendance) AS empty_seats
FROM bootcamp.default.matches_flat
ORDER BY (stadium_capacity - attendance) DESC
LIMIT 5;

/*
 Odgovor: Zajedničko prvim trima je domaći tim i stadion na kom su igrali:
        Oakfield Town i National Stadium
*/



--Zadatak 2)

SELECT DISTINCT referee_id, referee_name
FROM bootcamp.default.matches_flat
WHERE home_team = 'Riverton Athletic'
ORDER BY referee_id;

/* Odgovor: Domaće utakmice kluba Riverton Athletic sudilo je 15 različitih sudija. */



--Zadatak 3)

SELECT match_id, home_team, away_team,
    (home_goals_ht - away_goals_ht) AS half_time_goal_diff,
    (home_goals - away_goals) AS final_goal_diff
FROM bootcamp.default.matches_flat
WHERE (away_goals_ht > home_goals_ht) AND (home_goals > away_goals);

/* Odgovor: U 15 mečeva je na poluvremenu vodio gost, a na kraju pobednik bio domaćin. */



--Zadatak 4)

SELECT home_team, away_team, 
 home_goals_ht, away_goals_ht,
 home_goals, away_goals,
 (home_goals_ht + away_goals_ht) AS HT_goals
FROM bootcamp.default.matches_flat
ORDER BY ((home_goals + away_goals) - (home_goals_ht + away_goals_ht)) DESC, (home_goals + away_goals) DESC
LIMIT 1;

/* Odgovor: Utakmica Northport United - Newbury Forest je bila utakmica sa najzanimljivijim
 drugim poluvremenom što se golova tiče u poslednjih par sezona,
 sa skromnih 1-0 na poluvremenu i fantastičnih 6-3 na kraju utakmice */



--Zadatak 5)

SELECT match_id, home_team, away_team
FROM bootcamp.default.matches_flat
WHERE season = '2023/24' AND (weather = 'fog' OR weather = 'snow')
ORDER BY kickoff_ts;

/* Odgovor: U sezoni 2023/24 bilo je 25 utakmica odigranih u uslovima snega i magle. */



--Zadatak 6)

SELECT match_id, home_team, away_team, season,
    (home_goals - away_goals) AS goal_diff
FROM bootcamp.default.matches_flat
WHERE (home_team = 'Northport United' OR away_team = 'Northport United')
    AND (home_team = 'Northport City' OR away_team = 'Northport City')
ORDER BY kickoff_ts;

/* Odgovor: Northport United i Northport City su odigrali četiri meča,
po dva u sezonama 2023/24 i 2024/25. Jedini način koji mi je pao na pamet
da odgovorim ko je pobednik svakog meča je da u posebnoj koloni prikažem
gol razliku na tim mečevima. */

