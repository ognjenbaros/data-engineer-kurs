-- 3. Koliko utakmica ima više kartona od prosečne utakmice? Bez
-- kartona računajte sa 0.


SELECT COUNT(DISTINCT me.match_id)
FROM match_events AS me
WHERE EXISTS (
    SELECT 1
    FROM match_events AS mes
    WHERE me.match_id = mes.match_id
    GROUP BY mes.match_id
    HAVING SUM(CASE WHEN mes.event_type IN ('yellow_card', 'second_yellow', 'red_card') THEN 1 ELSE 0 END) > (
        SELECT
            SUM(CASE WHEN event_type IN ('yellow_card', 'second_yellow', 'red_card') THEN 1 ELSE 0 END) / COUNT(DISTINCT match_id)
        FROM match_events));




-- 4. Koliko igrača je odigralo više od 10 utakmica u sezoni
-- 2024/25?


SELECT pms.player_id, COUNT_IF(pms.minutes_played > 0) AS matches_played 
FROM player_match_stats AS pms
INNER JOIN matches AS m ON m.match_id = pms.match_id AND m.season = '2024/25'
GROUP BY pms.player_id
HAVING matches_played > 10
ORDER BY matches_played DESC;




-- 5. Prikažite sve klubove koji su igrali u sezoni 2024/25, bilo kao
-- domaćini ili kao gosti. Koristite UNION, a zatim izmenite upit
-- tako da koristi UNION ALL. Objasnite razliku u broju redova koji
-- dobijate.


SELECT t.team_name 
FROM teams AS t
JOIN matches AS m ON m.home_team_id = t.team_id AND m.season = '2024/25'
GROUP BY t.team_name
UNION
SELECT t.team_name 
FROM teams AS t
JOIN matches AS m ON m.away_team_id = t.team_id AND m.season = '2024/25'
GROUP BY t.team_name;


SELECT t.team_name 
FROM teams AS t
JOIN matches AS m ON m.home_team_id = t.team_id AND m.season = '2024/25'
GROUP BY t.team_name
UNION ALL
SELECT t.team_name 
FROM teams AS t
JOIN matches AS m ON m.away_team_id = t.team_id AND m.season = '2024/25'
GROUP BY t.team_name;

--UNION izbacuje duplikate, dok UNION ALL spaja dve tabele bez ikakvih provera