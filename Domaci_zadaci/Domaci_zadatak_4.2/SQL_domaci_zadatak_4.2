#7

WITH        club AS (SELECT team_id FROM teams WHERE team_name = 'Queensport FC')
SELECT s.stadium_name,
        ROUND(AVG(m.attendance), 2) AS avg_att_home,
        ROUND(100 * AVG(m.attendance/s.capacity), 2) AS avg_fill_percentage_home,
        SUM(CASE WHEN m.attendance IS NULL THEN 1 ELSE 0 END) AS att_no_info
FROM teams AS t
RIGHT JOIN club AS c ON c.team_id = t.team_id
JOIN stadiums AS s ON t.stadium_id = s.stadium_id
JOIN matches AS m ON m.home_team_id = c.team_id AND m.season = '2024/25'
GROUP BY s.stadium_name;


