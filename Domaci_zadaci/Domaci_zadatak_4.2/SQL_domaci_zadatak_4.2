SELECT ms.manager_name, 
    ( gh.team_wins + ga.team_wins ) * 3 + ( gh.team_draws + ga.team_draws ) AS points
FROM manager_spells AS ms
JOIN club AS c ON ms.team_id = c.team_id
JOIN games_away AS ga ON ga.team_id = c.team_id
JOIN games_home AS gh ON gh.team_id = c.team_id;



