-- 1. Prosek datih golova u poslednjih 5 utakmica, uz izričit
-- okvir prozora. Koja je najveća vrednost? Računajte
-- samo kada prozor zaista ima 5 utakmica.

SELECT * FROM team_matches ORDER BY team_id, kickoff_ts LIMIT 100;

SELECT t.team_name,
        ROUND(AVG(tm.goals_for) OVER (PARTITION BY tm.team_id ORDER BY tm.match_id 
                                                        ROWS BETWEEN 4 PRECEDING AND CURRENT ROW), 2) AS avg_last_5
FROM team_matches AS tm
JOIN teams AS t ON t.team_id = tm.team_id
ORDER BY avg_last_5 DESC;


