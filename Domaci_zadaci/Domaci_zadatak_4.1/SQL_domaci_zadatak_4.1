
-- 1. Koliko redova ima spoj matches i player_match_stats za sezonu 2024/25? Objasnite.


SELECT COUNT(match_id) FROM player_match_stats WHERE match_id LIKE '2%';
SELECT COUNT(match_id) FROM matches WHERE season = '2024/25';

SELECT COUNT(*)
FROM matches AS m
JOIN player_match_stats AS pms ON m.match_id = pms.match_id AND m.season = '2024/25';

-- U sezoni 2024/25 ima 380 meceva (matches).
