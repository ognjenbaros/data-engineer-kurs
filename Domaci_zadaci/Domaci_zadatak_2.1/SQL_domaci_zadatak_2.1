
--Prvi zadatak)

SELECT match_id, home_team, away_team, stadium_name,
    (stadium_capacity - attendance) AS empty_seats
FROM bootcamp.default.matches_flat
ORDER BY (stadium_capacity - attendance) DESC
LIMIT 5;

/*
 Odgovor: Zajednično prvim trima je domaći tim, i stadion na kom su igrali:
        Oakfield Town i National Stadium
*/



--Zadatak 2)

SELECT DISTINCT referee_id, referee_name
FROM bootcamp.default.matches_flat
WHERE home_team = 'Riverton Athletic'
ORDER BY referee_id;

/* Odgovor: Domaće utakmice kluba Riverton Athletic sudilo je 15 različitih sudija. */



--Zadatak 3)

SELECT match_id, home_team, away_team,
    (home_goals_ht - away_goals_ht) AS half_time_goal_diff,
    (home_goals - away_goals) AS final_goal_diff
FROM bootcamp.default.matches_flat
WHERE (away_goals_ht > home_goals_ht) AND (home_goals > away_goals);

/* Odgovor: U 15 mečeva je na poluvremenu vodio gost, a na kraju pobednik bio domaćin. */

